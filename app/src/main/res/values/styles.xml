<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CalculatorButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/text_color</item>
        <item name="backgroundTint">@color/button_color</item>
    </style>

    <style name="CalculatorButton.Operator" parent="CalculatorButton">
        <item name="backgroundTint">@color/accent_color</item>
    </style>

    <style name="CalculatorButton.Equals" parent="CalculatorButton">
        <item name="backgroundTint">@color/accent_color</item>
    </style>
</resources>
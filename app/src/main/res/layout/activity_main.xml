<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Calculator Result -->
        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/result"
            android:textSize="32sp"
            android:gravity="end"
            android:padding="16dp" />

        <!-- Calculator Buttons -->
        <GridLayout
            android:id="@+id/gridCalculator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:rowCount="5"
            android:layout_marginTop="16dp">

            <Button style="@style/CalculatorButton.Operator"
                android:id="@+id/btnClear"
                android:text="@string/clear" />
            <Button style="@style/CalculatorButton.Operator"
                android:id="@+id/btnDivide"
                android:text="@string/divide" />
            <Button style="@style/CalculatorButton.Operator"
                android:id="@+id/btnMultiply"
                android:text="@string/multiply" />
            <Button style="@style/CalculatorButton.Operator"
                android:id="@+id/btnBack"
                android:text="@string/backspace" />

            <Button style="@style/CalculatorButton" android:id="@+id/btn7" android:text="@string/digit_7"/>
            <Button style="@style/CalculatorButton" android:id="@+id/btn8" android:text="@string/digit_8"/>
            <Button style="@style/CalculatorButton" android:id="@+id/btn9" android:text="@string/digit_9"/>
            <Button style="@style/CalculatorButton.Operator" android:id="@+id/btnMinus" android:text="@string/minus"/>

            <Button style="@style/CalculatorButton" android:id="@+id/btn4" android:text="@string/digit_4"/>
            <Button style="@style/CalculatorButton" android:id="@+id/btn5" android:text="@string/digit_5"/>
            <Button style="@style/CalculatorButton" android:id="@+id/btn6" android:text="@string/digit_6"/>
            <Button style="@style/CalculatorButton.Operator" android:id="@+id/btnPlus" android:text="@string/plus"/>

            <Button style="@style/CalculatorButton" android:id="@+id/btn1" android:text="@string/digit_1"/>
            <Button style="@style/CalculatorButton" android:id="@+id/btn2" android:text="@string/digit_2"/>
            <Button style="@style/CalculatorButton" android:id="@+id/btn3" android:text="@string/digit_3"/>
            <Button style="@style/CalculatorButton.Equals" android:id="@+id/btnEqual" android:text="@string/equal"/>

            <Button style="@style/CalculatorButton" android:id="@+id/btn0" android:text="@string/digit_0"/>
            <Button style="@style/CalculatorButton.Operator" android:id="@+id/btnDot" android:text="@string/dot"/>
            <Button style="@style/CalculatorButton.Operator" android:id="@+id/btnPercent" android:text="@string/percent"/>
            <Button style="@style/CalculatorButton.Equals" android:id="@+id/btnEmpty" android:visibility="invisible"/>

        </GridLayout>

        <!-- Conversion Section -->
        <TextView
            android:id="@+id/tvConverterLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/converter_label"
            android:textSize="20sp"
            android:layout_marginTop="24dp" />

        <EditText
            android:id="@+id/etInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Enter value"
            android:inputType="numberDecimal"
            android:minHeight="48dp" />

        <Spinner
            android:id="@+id/spinnerConversion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/btnConvert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/convert"
            android:textColor="#795548" />

        <TextView
            android:id="@+id/tvConversionResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="18sp"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</ScrollView>
